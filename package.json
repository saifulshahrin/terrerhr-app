{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:pilot-guard": "node --test --test-isolation=none tests/pilotTargetGuard.test.mjs",
    "test:canonical-compensation": "node --experimental-strip-types --test --test-isolation=none tests/canonicalCompensationContract.test.mjs tests/unifiedOpportunityQuery.test.mjs tests/unifiedOpportunityAuthApi.test.mjs",
    "test:unified-opportunities": "node --experimental-strip-types --test --test-isolation=none tests/unifiedOpportunityQuery.test.mjs",
    "test:candidate-self-provisioning": "node --test --test-isolation=none tests/candidateSelfProvisioning.test.mjs",
    "test:unified-opportunity-api": "node --experimental-strip-types --test --test-isolation=none tests/unifiedOpportunityAuthApi.test.mjs",
    "test:production-ledger-exception": "node --test --test-isolation=none tests/productionLedgerException.test.mjs",
    "test:candidate-engine-authorization": "node --test --test-isolation=none tests/candidateEngineAuthorization.test.mjs",
    "validate:ledger-restoration": "node scripts/validate-ledger-restoration.mjs",
    "validate:unified-opportunity-gate1": "node scripts/validate-production-ledger-exception.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.344.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
